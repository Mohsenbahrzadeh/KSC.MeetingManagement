@inherits LayoutComponentBase

<MudRTLProvider RightToLeft="true">
    <MudThemeProvider Theme="KscTheme.Default" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <MudLayout>
        <MudAppBar Elevation="1">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                           aria-label="باز و بسته کردن منو" OnClick="ToggleDrawer" />
            <MudText Typo="Typo.h6" Class="ms-2">مدیریت جلسات</MudText>
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md"
                   ClipMode="DrawerClipMode.Always" Elevation="0" aria-label="منوی اصلی">
            <nav aria-label="منوی اصلی">
                <MudNavMenu>
                    @foreach (var item in NavItems.Main)
                    {
                        <MudNavLink Href="@item.Href" Icon="@item.Icon"
                                    Match="@(item.ExactMatch ? NavLinkMatch.All : NavLinkMatch.Prefix)">@item.Title</MudNavLink>
                    }
                </MudNavMenu>
            </nav>
        </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
</MudRTLProvider>

<div id="blazor-error-ui" data-nosnippet>
    خطای غیرمنتظره‌ای رخ داد.
    <a href="." class="reload">بارگذاری دوباره</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}

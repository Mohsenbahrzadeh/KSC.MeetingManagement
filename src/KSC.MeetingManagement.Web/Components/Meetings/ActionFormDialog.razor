@using KSC.MeetingManagement.Application.Actions
@using KSC.MeetingManagement.Application.Identity
@using KSC.MeetingManagement.Application.Resolutions
@using KSC.MeetingManagement.Calendar
@using KSC.MeetingManagement.Calendar.Components
@using KSC.MeetingManagement.Domain.Meetings
@using KSC.MeetingManagement.Web.Services
@inject ActionsApiClient Api
@inject UsersApiClient Users
@inject ResolutionsApiClient Resolutions
@inject SessionState Session

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField @bind-Value="_title" Label="عنوان اقدام" Required="true" MaxLength="ActionItem.MaxTitleLength" Disabled="_saving"
                          Error="@(_titleError is not null)" ErrorText="@_titleError" />
            <MudTextField @bind-Value="_description" Label="توضیحات" Lines="3" MaxLength="ActionItem.MaxDescriptionLength" Disabled="_saving" />
            <MudSelect T="Guid?" @bind-Value="_ownerId" Label="مسئول" Required="true" Disabled="_saving"
                       Error="@(_ownerError is not null)" ErrorText="@_ownerError">
                @foreach (var member in _members)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)member.UserId)">@(string.IsNullOrWhiteSpace(member.DisplayName) ? member.Email : member.DisplayName)</MudSelectItem>
                }
                @if (Session.User?.Id is { } self && _members.All(m => m.UserId != self))
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)self)">شما</MudSelectItem>
                }
                @if (_ownerId is { } owner && _members.All(m => m.UserId != owner))
                {
                    @if (owner != Session.User?.Id)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)owner)">مسئول فعلی</MudSelectItem>
                    }
                }
            </MudSelect>
            @if (_membersMessage is not null)
            {
                <MudText Typo="Typo.caption">@_membersMessage</MudText>
            }
            <div>
                <KscJalaliDatePicker @bind-Value="_due" Label="سررسید" Required="true" Disabled="_saving" />
                @if (_dateError is not null) { <MudText Color="Color.Error" role="alert">@_dateError</MudText> }
            </div>
            @if (Item is null)
            {
                <MudSelect T="Guid?" @bind-Value="_resolutionId" Label="مصوبه (اختیاری)" Clearable="true" Disabled="_saving">
                    @foreach (var resolution in _resolutions)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)resolution.Id)">مصوبهٔ @PersianText.Digits(resolution.Number): @resolution.Text</MudSelectItem>
                    }
                </MudSelect>
            }
            @if (_serverError is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" role="alert">@_serverError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Disabled="_saving" OnClick="Cancel">انصراف</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_saving || _conflict)" OnClick="SaveAsync">ذخیره</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly IKscJalaliCalendar _calendar = KscJalaliCalendarService.Instance;
    private List<MemberDto> _members = [];
    private List<ResolutionDto> _resolutions = [];
    private string _title = "";
    private string? _description;
    private Guid? _ownerId;
    private Guid? _resolutionId;
    private JalaliDate? _due;
    private string? _titleError;
    private string? _ownerError;
    private string? _dateError;
    private string? _membersMessage;
    private string? _serverError;
    private bool _saving;
    private bool _conflict;

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public Guid MeetingId { get; set; }
    [Parameter] public ActionItemDto? Item { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Item is { } item)
        {
            _title = item.Title;
            _description = item.Description;
            _ownerId = item.OwnerUserId;
            _due = FromGregorianSafe(item.DueDate);
        }
        else
        {
            _ownerId = Session.User?.Id;
            _due = FromGregorianSafe(DateOnly.FromDateTime(DateTime.UtcNow.Date));
            if (await Resolutions.ListAsync(MeetingId, CancellationToken.None) is { Succeeded: true, Value: { } list })
                _resolutions = list;
        }

        var members = await Users.ListAsync(CancellationToken.None);
        if (members.Succeeded && members.Value is { } listOfMembers)
        {
            _members = listOfMembers.Where(m => m.MembershipActive && m.UserActive).ToList();
        }
        else
        {
            _membersMessage = "فهرست اعضا در دسترس نیست؛ می‌توانید خودتان را مسئول کنید یا مسئول فعلی را حفظ کنید.";
        }
    }

    private async Task SaveAsync()
    {
        _titleError = string.IsNullOrWhiteSpace(_title) ? "عنوان اقدام را وارد کنید." :
            _title.Trim().Length > ActionItem.MaxTitleLength ? "عنوان بیش از حد طولانی است." : null;
        _ownerError = _ownerId is null || _ownerId == Guid.Empty ? "مسئول را انتخاب کنید." : null;
        _dateError = _due is null ? "سررسید را انتخاب کنید." : null;
        if (_titleError is not null || _ownerError is not null || _dateError is not null) return;
        if (_description?.Length > ActionItem.MaxDescriptionLength)
        {
            _serverError = "توضیحات بیش از حد طولانی است.";
            return;
        }
        var dueDate = _calendar.ToGregorian(_due!.Value);

        _saving = true;
        _serverError = null;
        try
        {
            var input = new ActionItemInput(_title.Trim(), _description, _ownerId!.Value, dueDate, Item is null ? _resolutionId : Item.ResolutionId);
            var result = Item is { } item
                ? await Api.UpdateAsync(MeetingId, item.Id, item.LockVersion, input, CancellationToken.None)
                : await Api.CreateAsync(MeetingId, input, CancellationToken.None);
            if (result.Succeeded && result.Value is { } saved)
            {
                Dialog.Close(DialogResult.Ok(saved));
                return;
            }
            _serverError = result.Message ?? ApiResultReader.GenericFailure;
            _conflict = result.Error == ApiErrorKind.VersionConflict;
        }
        finally { _saving = false; }
    }

    private void Cancel() => Dialog.Cancel();

    private JalaliDate? FromGregorianSafe(DateOnly day)
    {
        try { return _calendar.FromGregorian(day); }
        catch (ArgumentOutOfRangeException) { return null; }
    }
}

@page "/Error"
@using System.Diagnostics

<PageTitle>خطا</PageTitle>

<MudText Typo="Typo.h4" Color="Color.Error" Class="mb-2" tabindex="-1">خطایی رخ داد</MudText>
<MudText Class="mb-2">درخواست شما انجام نشد. لطفاً دوباره تلاش کنید.</MudText>
@if (ShowRequestId)
{
    <MudText Typo="Typo.body2">شناسهٔ پیگیری: <code>@RequestId</code></MudText>
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}

@page "/meetings/{MeetingId:guid}/room"
@using KSC.MeetingManagement.Web.Services
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject RoomApiClient Rooms
@inject SessionState Session
@inject ISnackbar Snackbar

<PageTitle>اتاق جلسه | مدیریت جلسات</PageTitle>

<div class="ksc-room-page">
<header class="ksc-room-topline">
    <strong>جلسهٔ آنلاین</strong>
    <span aria-hidden="true">·</span>
    <span>کد جلسه: @(MeetingId.ToString("N")[..8])</span>
    @if (_connectionQuality != "unknown")
    {
        <span class="ksc-room-top-quality">@ConnectionQualityLabel(_connectionQuality)</span>
    }
</header>

@if (_phase == Phase.Lobby || _phase == Phase.Waiting || _phase == Phase.Joining)
{
    <MudPaper Class="ksc-card pa-4 ksc-room-lobby" Elevation="0">
        <div class="ksc-room-lobby-copy">
            <span class="ksc-room-eyebrow">اتاق امن جلسه</span>
            <h1>برای پیوستن آماده‌اید؟</h1>
            <p>پیش از ورود، تصویر و صدای خود را بررسی کنید. تنظیمات را هر زمان می‌توانید تغییر دهید.</p>
            <div class="ksc-room-lobby-meeting"><MudIcon Icon="@Icons.Material.Filled.MeetingRoom" /> <span>شناسهٔ جلسه</span><strong>@MeetingId.ToString("N")[..8]</strong></div>
        </div>
        <div class="ksc-room-preview-wrap">
            <video @ref="_preview" class="ksc-preview" autoplay playsinline muted aria-label="پیش‌نمایش تصویر شما"></video>
            @if (!_camera || _previewProblem is not null)
            {
                <div class="ksc-room-preview-placeholder" role="status">
                    <span><MudIcon Icon="@Icons.Material.Filled.VideocamOff" /></span>
                    <strong>@(!_camera ? "دوربین خاموش است" : "پیش‌نمایش در دسترس نیست")</strong>
                    <small>@(!_camera ? "می‌توانید با صدا وارد جلسه شوید." : "مجوز دوربین یا اتصال دستگاه را بررسی کنید؛ همچنان می‌توانید وارد شوید.")</small>
                </div>
            }
            <span class="ksc-room-preview-label"><MudIcon Icon="@Icons.Material.Filled.Person" /> پیش‌نمایش شما</span>
        </div>
        @if (_previewProblem is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="my-3" role="alert">@_previewProblem</MudAlert>
        }
        <div class="ksc-room-toggles">
            <div class="ksc-room-device-control">
                <MudToggleIconButton Toggled="_mic" ToggledChanged="OnMicPreviewChanged" Icon="@Icons.Material.Filled.MicOff" ToggledIcon="@Icons.Material.Filled.Mic"
                                     Color="Color.Default" ToggledColor="Color.Primary" aria-label="میکروفون" Disabled="_phase != Phase.Lobby" />
                <span>@(_mic ? "میکروفون روشن" : "میکروفون خاموش")</span>
            </div>
            <div class="ksc-room-device-control">
                <MudToggleIconButton Toggled="_camera" ToggledChanged="OnCameraPreviewChanged" Icon="@Icons.Material.Filled.VideocamOff" ToggledIcon="@Icons.Material.Filled.Videocam"
                                     Color="Color.Default" ToggledColor="Color.Primary" aria-label="دوربین" Disabled="_phase != Phase.Lobby" />
                <span>@(_camera ? "دوربین روشن" : "دوربین خاموش")</span>
            </div>
        </div>

        @if (_message is not null)
        {
            <MudAlert Severity="@(_phase == Phase.Waiting ? Severity.Info : Severity.Error)" Class="my-3" role="status">@_message</MudAlert>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="ksc-room-join" OnClick="JoinAsync"
                   Disabled="_phase != Phase.Lobby" StartIcon="@Icons.Material.Filled.MeetingRoom">ورود به جلسه</MudButton>
    </MudPaper>
}

<div class="ksc-room @(_phase == Phase.InRoom ? string.Empty : "d-none")">
    @if (_phase == Phase.InRoom)
    {
        <div class="ksc-room-bar" role="toolbar" aria-label="کنترل جلسه">
            <div class="ksc-room-presence-controls">
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="ksc-room-roster-toggle"
                       StartIcon="@Icons.Material.Filled.PeopleAlt" aria-expanded="@_showParticipants"
                       aria-controls="ksc-room-participant-list" OnClick="() => _showParticipants = !_showParticipants">
                شرکت‌کنندگان · @_participants.Count
            </MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="ksc-room-whiteboard-toggle"
                       StartIcon="@Icons.Material.Filled.Edit" aria-expanded="@_showWhiteboard"
                       aria-controls="ksc-room-whiteboard" OnClick="ToggleWhiteboardAsync">
                @(_showWhiteboard ? "بستن وایت‌برد" : "وایت‌برد")
            </MudButton>
            @if (_isPresenter)
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="ksc-mute-all-control" OnClick="MuteAllAsync" Disabled="_mutingAll"
                           StartIcon="@Icons.Material.Filled.MicOff" aria-label="بی‌صدا کردن همهٔ شرکت‌کنندگان">
                    @(_mutingAll ? "در حال بی‌صدا کردن…" : "بی‌صدا کردن همه")
                </MudButton>
            }
            @if (!_isPresenter && _muteAllNotice)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="ksc-mute-all-notice" role="status">
                    برگزارکننده میکروفن‌ها را بی‌صدا کرده است.
                    @if (_speakApproved)
                    {
                        <span>درخواست شما تأیید شد؛ برای صحبت میکروفن را روشن کنید.</span>
                    }
                    else if (_speakRequested)
                    {
                        <span>درخواست صحبت برای برگزارکننده ارسال شده است.</span>
                    }
                    else
                    {
                        <span>برای صحبت از دکمهٔ «درخواست صحبت» استفاده کنید.</span>
                    }
                </MudAlert>
            }
            @if (!_isPresenter)
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick='() => RequestPermissionAsync("speak")' Disabled="@(_speakRequested || _speakApproved)" StartIcon="@Icons.Material.Filled.FrontHand">
                    @(_speakApproved ? "اجازهٔ صحبت دارید" : _speakRequested ? "درخواست صحبت ارسال شد" : "درخواست صحبت")
                </MudButton>
            }
            @if (_state == "reconnecting")
            {
                <MudChip T="string" Color="Color.Warning" Size="Size.Small">در حال اتصال مجدد…</MudChip>
            }
            @if (_connectionQuality != "unknown")
            {
                <MudChip T="string" Color="@(_connectionQuality is "poor" or "lost" ? Color.Warning : Color.Info)" Size="Size.Small" role="status">
                    کیفیت شبکه: @ConnectionQualityLabel(_connectionQuality) · @_videoProfile
                </MudChip>
            }
            </div>
            <div class="ksc-room-media-controls" aria-label="صدا و تصویر">
            <MudToggleIconButton Toggled="_mic" ToggledChanged="SetMicAsync" Icon="@Icons.Material.Filled.MicOff" ToggledIcon="@Icons.Material.Filled.Mic"
                                  Color="Color.Error" ToggledColor="Color.Primary" Class="ksc-room-control-toggle" aria-label="میکروفون" title="میکروفون"
                                  Disabled="@(!_isPresenter && !_speakApproved)" />
            <MudToggleIconButton Toggled="_camera" ToggledChanged="SetCameraAsync" Icon="@Icons.Material.Filled.VideocamOff" ToggledIcon="@Icons.Material.Filled.Videocam"
                                 Color="Color.Error" ToggledColor="Color.Primary" Class="ksc-room-control-toggle" aria-label="دوربین" title="دوربین" />
            <MudButton Variant="Variant.Outlined" Color="@(_sharing ? Color.Primary : Color.Default)" OnClick="ShareScreenAsync"
                       Disabled="@(!_isPresenter && !_screenShareApproved && _screenShareRequested)"
                       StartIcon="@(_sharing ? Icons.Material.Filled.StopScreenShare : Icons.Material.Filled.ScreenShare)" aria-label="اشتراک صفحه">
                        @(_sharing ? "توقف اشتراک" : _screenShareRequested ? "درخواست ارسال شد" : _isPresenter || _screenShareApproved ? "اشتراک صفحه" : "درخواست اشتراک صفحه")
            </MudButton>
            </div>
            <div class="ksc-room-tools-controls" aria-label="ابزارهای جلسه">
            @if (!_isPresenter && !_whiteboardApproved)
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick='() => RequestPermissionAsync("whiteboard")' Disabled="@_whiteboardRequested" StartIcon="@Icons.Material.Filled.Edit">
                    @(_whiteboardRequested ? "درخواست وایت‌برد ارسال شد" : "درخواست وایت‌برد")
                </MudButton>
            }
            @if (_isPresenter && _permissionRequests.Count > 0)
            {
                <div class="ksc-permission-requests" role="group" aria-label="درخواست‌های دسترسی">
                    @foreach (var participantRequest in _permissionRequests.GroupBy(request => new { request.Identity, request.Name }))
                    {
                        <div class="ksc-permission-request" @key="participantRequest.Key.Identity">
                            <span class="ksc-raised-hand" aria-label="دست بلند کرده">✋</span>
                            <strong>@participantRequest.Key.Name</strong>
                            <MudButton Size="Size.Small" Color="Color.Primary" OnClick='() => DecidePermissionAsync(participantRequest.Key.Identity, "speak", true)'>اجازهٔ صحبت</MudButton>
                            <MudButton Size="Size.Small" Color="Color.Primary" OnClick='() => DecidePermissionAsync(participantRequest.Key.Identity, "screen-share", true)'>اجازهٔ اشتراک صفحه</MudButton>
                            <MudButton Size="Size.Small" Color="Color.Primary" OnClick='() => DecidePermissionAsync(participantRequest.Key.Identity, "whiteboard", true)'>اجازهٔ وایت‌برد</MudButton>
                            <MudButton Size="Size.Small" Color="Color.Error" OnClick='() => RejectPermissionRequestAsync(participantRequest.Key.Identity)'>رد درخواست</MudButton>
                        </div>
                    }
                </div>
            }
            @if (_isPresenter)
            {
                <MudButton Variant="Variant.Outlined" Color="@(_serverRecording ? Color.Error : Color.Default)" OnClick="ToggleServerRecordingAsync"
                           StartIcon="@(_serverRecording ? Icons.Material.Filled.StopCircle : Icons.Material.Filled.FiberManualRecord)">
                    @(_serverRecording ? "توقف ضبط سروری" : "ضبط سروری جلسه")
                </MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="TranscribeAsync" Disabled="@(_transcribing || _serverRecording)"
                           StartIcon="@Icons.Material.Filled.Subtitles">
                    @(_transcribing ? "در حال رونویسی…" : "رونویسی محلی")
                </MudButton>
            }
            @if (_serverRecording)
            {
                <MudChip T="string" Color="Color.Error" Size="Size.Small" role="status">● ضبط سروری فعال است</MudChip>
            }
            <MudButton Variant="Variant.Outlined" Color="@(_localRecording ? Color.Error : Color.Default)" OnClick="ToggleLocalRecordingAsync"
                       StartIcon="@(_localRecording ? Icons.Material.Filled.StopCircle : Icons.Material.Filled.Download)">
                @(_localRecording ? $"توقف ضبط محلی · بخش {_localRecordingPart:00}" : "ضبط برای من")
            </MudButton>
            @if (_localRecording)
            {
                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Class="ksc-local-recording-chip" role="status">● ضبط محلی مرورگر · ذخیره روی دستگاه شما</MudChip>
            }
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="LeaveAsync" StartIcon="@Icons.Material.Filled.CallEnd">خروج</MudButton>
        </div>
        <div @ref="_tiles" class="ksc-room-grid" aria-live="polite">
            <div class="ksc-room-empty" role="status">
                <span class="ksc-room-empty-icon"><MudIcon Icon="@Icons.Material.Filled.VideocamOff" Size="Size.Large" /></span>
                <strong>در انتظار تصویر شرکت‌کنندگان</strong>
                <span>با روشن‌شدن دوربین‌ها، تصویر حاضران در این بخش نمایش داده می‌شود.</span>
            </div>
        </div>
        @if (_transcript is not null)
        {
            <MudExpansionPanels Class="ksc-transcript">
                <MudExpansionPanel Text="متن پیاده‌شدهٔ جلسه">
                    <MudText Typo="Typo.caption">زبان: @_transcript.Language · زمان تولید: @_transcript.GeneratedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</MudText>
                    <MudText Class="mt-2" Style="white-space: pre-wrap; direction: rtl">@_transcript.Text</MudText>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
        @if (_showParticipants)
        {
            <section class="ksc-room-roster" id="ksc-room-participant-list" role="region" aria-label="شرکت‌کنندگان جلسه">
                <div class="ksc-room-roster-heading">
                    <strong>افراد حاضر در جلسه</strong>
                </div>
                @if (_participants.Count == 0)
                {
                    <span class="ksc-room-roster-empty">فهرست شرکت‌کنندگان در حال دریافت است…</span>
                }
                else
                {
                    <ul class="ksc-room-roster-list">
                        @foreach (var participant in _participants)
                        {
                            <li @key="participant.Identity">
                                <span class="ksc-room-roster-avatar" aria-hidden="true">@ParticipantInitial(participant.Name)</span>
                                <span class="ksc-room-roster-name">
                                    @participant.Name @if (participant.IsLocal) { <small>(شما)</small> }
                                    @if (_permissionRequests.Any(request => request.Identity == participant.Identity)
                                        || (!_isPresenter && participant.IsLocal && (_speakRequested || _screenShareRequested || _whiteboardRequested)))
                                    {
                                        <span class="ksc-raised-hand" role="img" aria-label="درخواست دسترسی در انتظار تأیید" title="درخواست دسترسی در انتظار تأیید">✋</span>
                                    }
                                </span>
                                <span class="ksc-room-mic-state @(participant.IsMicrophoneEnabled ? "on" : "off")" role="status" aria-label="@(participant.IsMicrophoneEnabled ? "میکروفون روشن" : "میکروفون بی‌صدا")">
                                    <MudIcon Icon="@(participant.IsMicrophoneEnabled ? Icons.Material.Filled.Mic : Icons.Material.Filled.MicOff)"
                                             Class="@(participant.IsMicrophoneEnabled ? string.Empty : "ksc-mic-off-icon")" />
                                    <span>@(participant.IsMicrophoneEnabled ? "میکروفون روشن" : "بی‌صدا")</span>
                                </span>
                            </li>
                        }
                    </ul>
                }
            </section>
        }
    }
    @if (_phase == Phase.InRoom)
    {
        <section class="ksc-whiteboard @(_showWhiteboard ? string.Empty : "ksc-whiteboard-collapsed")" id="ksc-room-whiteboard" aria-label="تخته وایت‌برد مشترک" aria-hidden="@(!_showWhiteboard)">
            <div class="ksc-whiteboard-toolbar">
                <div>
                    <strong>تختهٔ وایت‌برد</strong>
                    <span>@(_isPresenter ? "در حال ارائه — شما کنترل تخته را دارید" : _whiteboardApproved ? "اجازهٔ ویرایش وایت‌برد را دارید" : "در حال مشاهدهٔ تختهٔ برگزارکننده")</span>
                </div>
                @if (_isPresenter || _whiteboardApproved)
                {
                    <div class="ksc-whiteboard-tools" role="toolbar" aria-label="ابزارهای وایت‌برد">
                        <button type="button" class="ksc-board-tool @(_whiteboardTool == "select" ? "active" : string.Empty)" aria-label="انتخاب و جابه‌جایی" title="انتخاب و جابه‌جایی" @onclick="SelectSelectAsync"><span>↖</span></button>
                        <button type="button" class="ksc-board-tool @(_whiteboardTool == "pen" ? "active" : string.Empty)" aria-label="قلم آزاد" title="قلم آزاد" @onclick="SelectPenAsync"><span>✎</span></button>
                        <button type="button" class="ksc-board-tool @(_whiteboardTool == "text" ? "active" : string.Empty)" aria-label="نوشتن متن" title="متن" @onclick="SelectTextAsync"><span>T</span></button>
                        <button type="button" class="ksc-board-tool @(_whiteboardTool == "line" ? "active" : string.Empty)" aria-label="رسم خط" title="خط" @onclick="SelectLineAsync"><span>／</span></button>
                        <button type="button" class="ksc-board-tool @(_whiteboardTool == "rectangle" ? "active" : string.Empty)" aria-label="رسم مستطیل" title="مستطیل" @onclick="SelectRectangleAsync"><span>▭</span></button>
                        <button type="button" class="ksc-board-tool @(_whiteboardTool == "circle" ? "active" : string.Empty)" aria-label="رسم دایره" title="دایره" @onclick="SelectCircleAsync"><span>◯</span></button>
                        <button type="button" class="ksc-board-tool @(_whiteboardTool == "triangle" ? "active" : string.Empty)" aria-label="رسم مثلث" title="مثلث" @onclick="SelectTriangleAsync"><span>△</span></button>
                        <button type="button" class="ksc-board-tool @(_whiteboardTool == "arrow" ? "active" : string.Empty)" aria-label="رسم پیکان" title="پیکان" @onclick="SelectArrowAsync"><span>↗</span></button>
                    </div>
                    <label class="ksc-whiteboard-color">رنگ قلم <input type="color" value="#17324D" aria-label="رنگ قلم وایت‌برد" @onchange="SetWhiteboardColorAsync" /></label>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="UndoWhiteboardAsync" StartIcon="@Icons.Material.Filled.Undo">واگرد</MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ClearWhiteboardAsync" StartIcon="@Icons.Material.Filled.DeleteOutline">پاک‌کردن</MudButton>
                }
            </div>
            <div class="ksc-whiteboard-stage">
                <canvas id="ksc-room-whiteboard-canvas" @ref="_whiteboard" class="ksc-whiteboard-canvas" aria-label="بوم وایت‌برد"></canvas>
            </div>
        </section>
    }
</div>

@if (_phase == Phase.Ended)
{
    <MudAlert Severity="Severity.Info" role="status">@(_message ?? "از جلسه خارج شدید.")</MudAlert>
    @if (_canReconnect)
    {
        <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" OnClick="ReconnectAsync" StartIcon="@Icons.Material.Filled.Refresh">اتصال دوباره</MudButton>
    }
    <MudButton Class="mt-3" Variant="Variant.Outlined" OnClick="BackToLobby">بازگشت به ورود</MudButton>
}
</div>

@code {
    public sealed record RoomParticipant(string Identity, string Name, bool IsLocal, bool IsMicrophoneEnabled = false);
    public sealed record PermissionRequest(string Identity, string Name, string Capability);

    private enum Phase { Lobby, Joining, Waiting, InRoom, Ended }

    private IJSObjectReference? _module;
    private DotNetObjectReference<Room>? _self;
    private ElementReference _preview;
    private ElementReference _tiles;
    private ElementReference _whiteboard;
    private Phase _phase = Phase.Lobby;
    private string? _message;
    private string? _previewProblem;
    private string _state = "connected";
    private string _connectionQuality = "unknown";
    private string _videoProfile = "adaptive 1080p";
    private IReadOnlyList<RoomParticipant> _participants = [];
    private bool _mic = true;
    private bool _camera = true;
    private bool _sharing;
    private bool _serverRecording;
    private bool _transcribing;
    private MeetingTranscriptDto? _transcript;
    private bool _localRecording;
    private int _localRecordingPart = 1;
    private bool _screenShareRequested;
    private bool _screenShareApproved;
    private bool _whiteboardRequested;
    private bool _whiteboardApproved;
    private bool _disposed;
    private bool _restartPreview;
    private bool _canReconnect;
    private bool _isPresenter;
    private string _whiteboardTool = "pen";
    private IReadOnlyList<PermissionRequest> _permissionRequests = [];
    private bool _mutingAll;
    private bool _showParticipants;
    private bool _showWhiteboard;
    private bool _muteAllNotice;
    private bool _speakRequested;
    private bool _speakApproved;

    [Parameter]
    public Guid MeetingId { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            // The self view lives in a new element after coming back to the lobby, so it is opened after that render.
            if (_restartPreview)
            {
                _restartPreview = false;
                await RestartPreviewAsync();
            }

            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./ksc-room.js");
        _self = DotNetObjectReference.Create(this);
        if (!await _module.InvokeAsync<bool>("isSupported"))
        {
            _previewProblem = "این مرورگر از تماس تصویری پشتیبانی نمی‌کند. از نسخهٔ جدید Chrome، Edge، Firefox یا Safari استفاده کنید.";
            StateHasChanged();
            return;
        }

        await RestartPreviewAsync();
    }

    private async Task OnCameraPreviewChanged(bool value)
    {
        _camera = value;
        await RestartPreviewAsync();
    }

    private async Task OnMicPreviewChanged(bool value)
    {
        _mic = value;
        await RestartPreviewAsync();
    }

    /// <summary>Shows the self view and explains, in plain words, why a device could not be opened.</summary>
    private async Task RestartPreviewAsync()
    {
        if (_module is null)
        {
            return;
        }

        if (!_camera && !_mic)
        {
            await _module.InvokeVoidAsync("stopPreview");
            _previewProblem = null;
            StateHasChanged();
            return;
        }

        var code = await _module.InvokeAsync<string>("startPreview", _preview, _camera, _mic);
        _previewProblem = code switch
        {
            "ok" => null,
            "NotAllowedError" or "SecurityError" => "دسترسی به دوربین یا میکروفون مسدود است. در تنظیمات مرورگر اجازه بدهید یا بدون آنها وارد شوید.",
            "NotFoundError" or "OverconstrainedError" => "دوربین یا میکروفونی پیدا نشد. می‌توانید فقط شنونده وارد شوید.",
            "NotReadableError" or "AbortError" => "دوربین یا میکروفون در برنامهٔ دیگری در حال استفاده است.",
            _ => "باز کردن دوربین یا میکروفون ممکن نشد.",
        };
        StateHasChanged();
    }

    private async Task JoinAsync()
    {
        if (_module is null || _self is null)
        {
            return;
        }

        _canReconnect = false;
        _phase = Phase.Joining;
        _message = null;
        JoinResult result;
        do
        {
            result = await Rooms.JoinAsync(MeetingId, Session.User?.DisplayName, CancellationToken.None);
            if (result.Outcome != JoinOutcome.Waiting)
            {
                break;
            }

            // The host has not admitted us yet: ask again every few seconds.
            _phase = Phase.Waiting;
            _message = result.Message;
            StateHasChanged();
            await Task.Delay(TimeSpan.FromSeconds(5));
        }
        while (!_disposed);

        if (_disposed)
        {
            return;
        }

        if (result.Room is not { } room)
        {
            _phase = Phase.Lobby;
            _message = result.Message;
            return;
        }

        _phase = Phase.InRoom;
        _isPresenter = room.Role == "Host";
        _transcript = _isPresenter ? await Rooms.GetTranscriptAsync(MeetingId, CancellationToken.None) : null;
        StateHasChanged();
        await Task.Yield();
        var ice = room.IceServers?.Select(s => new { urls = s.Urls, username = s.Username, credential = s.Credential }).ToArray();
        if (!_isPresenter && !_speakApproved) _mic = false;
        try
        {
            var outcome = await _module.InvokeAsync<string>("connect", room.ServerUrl, room.Token, ice, _tiles, "ksc-room-whiteboard-canvas", _self, _mic, _camera, room.PresenterIdentity, _isPresenter);
            if (outcome != "ok")
            {
                _phase = Phase.Lobby;
                _message = $"اتصال به سرویس جلسه ({room.ServerUrl}) برقرار نشد. وضعیت LiveKit و دسترسی این مرورگر به نشانی را بررسی کنید. جزئیات: {outcome}";
                _restartPreview = true;
                return;
            }
        }
        catch (JSException ex)
        {
            try
            {
                await _module.InvokeVoidAsync("disconnect");
            }
            catch (JSException)
            {
                // Preserve the recoverable lobby state even if LiveKit cleanup also fails.
            }
            _phase = Phase.Lobby;
            _message = "اتصال جلسه برقرار شد، اما آماده‌سازی ابزارهای جلسه کامل نشد. صفحه را تازه کنید و دوباره تلاش کنید.";
            Snackbar.Add($"خطای آماده‌سازی اتاق: {ex.Message}", Severity.Error);
            _restartPreview = true;
            return;
        }

        _canReconnect = false;
    }

    private async Task SetMicAsync(bool on)
    {
        if (on && !_isPresenter && !_speakApproved)
        {
            Snackbar.Add("برای روشن‌کردن میکروفن، ابتدا از برگزارکننده اجازهٔ صحبت بگیرید.", Severity.Warning);
            _mic = false;
            return;
        }

        if (_module is not null)
        {
            try
            {
                var enabled = await _module.InvokeAsync<bool>("setMic", on);
                if (enabled != on)
                {
                    Snackbar.Add("تغییر وضعیت میکروفون انجام نشد. مجوز دسترسی یا اتصال دستگاه را بررسی کنید.", Severity.Error);
                }
                _mic = enabled;
                return;
            }
            catch (JSException ex)
            {
                Snackbar.Add($"تغییر وضعیت میکروفون انجام نشد: {ex.Message}", Severity.Error);
            }
        }

        _mic = !on;
    }


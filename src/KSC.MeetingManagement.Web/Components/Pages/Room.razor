    private async Task ShareScreenAsync()
    {
        if (_sharing)
        {
            if (_module is not null) _sharing = await _module.InvokeAsync<bool>("setScreenShare", false);
            return;
        }

        if (_isPresenter || _screenShareApproved)
        {
            if (_module is not null) _sharing = await _module.InvokeAsync<bool>("setScreenShare", true);
            return;
        }

        await RequestPermissionAsync("screen-share");
    }

    private async Task RequestPermissionAsync(string capability)
    {
        if (_isPresenter || _module is null) return;
        if (capability == "speak" && (_speakRequested || _speakApproved)) return;
        if (capability == "screen-share" && _screenShareRequested) return;
        if (capability == "whiteboard" && (_whiteboardRequested || _whiteboardApproved)) return;
        if (!await _module.InvokeAsync<bool>("requestPermission", capability))
        {
            Snackbar.Add("ارسال درخواست ممکن نشد؛ اتصال جلسه را بررسی کنید.", Severity.Error);
            return;
        }

        SetPermissionRequested(capability, true);
        Snackbar.Add(capability switch
        {
            "speak" => "درخواست صحبت برای برگزارکننده ارسال شد.",
            "screen-share" => "درخواست اشتراک صفحه برای برگزارکننده ارسال شد.",
            _ => "درخواست ویرایش وایت‌برد برای برگزارکننده ارسال شد."
        }, Severity.Info);
    }

    private async Task DecidePermissionAsync(string identity, string capability, bool allowed)
    {
        if (!_isPresenter || _module is null) return;
        string? error = null;
        if (capability == "speak")
        {
            error = await Rooms.SetMicrophonePermissionAsync(MeetingId, identity, allowed, CancellationToken.None);
        }
        else if (capability == "screen-share")
        {
            error = await Rooms.SetScreenSharePermissionAsync(MeetingId, identity, allowed, CancellationToken.None);
        }
        if (error is not null)
        {
            Snackbar.Add(error, Severity.Error);
            return;
        }

        if (!await _module.InvokeAsync<bool>("decidePermission", identity, capability, allowed))
        {
            Snackbar.Add("ارسال پاسخ دسترسی ممکن نشد؛ اتصال جلسه را بررسی کنید.", Severity.Error);
            return;
        }

        _permissionRequests = _permissionRequests.Where(request => request.Identity != identity).ToArray();
    }

    private Task RejectPermissionRequestAsync(string identity)
    {
        var request = _permissionRequests.FirstOrDefault(item => item.Identity == identity);
        return request is null ? Task.CompletedTask : DecidePermissionAsync(identity, request.Capability, false);
    }

    private void SetPermissionRequested(string capability, bool requested)
    {
        switch (capability)
        {
            case "speak": _speakRequested = requested; break;
            case "screen-share": _screenShareRequested = requested; break;
            case "whiteboard": _whiteboardRequested = requested; break;
        }
    }

    private async Task ToggleServerRecordingAsync()
    {
        if (!_isPresenter) return;
        if (!_serverRecording && !await JS.InvokeAsync<bool>("confirm", "با شروع ضبط سروری، تصویر و صدای جلسه روی سرور ذخیره می‌شود و در دسترس مدیران مجاز قرار می‌گیرد. از آگاه بودن شرکت‌کنندگان اطمینان دارید؟")) return;
        var starting = !_serverRecording;
        try
        {
            var error = await Rooms.SetRecordingAsync(MeetingId, starting, CancellationToken.None);
            if (error is not null)
            {
                Snackbar.Add(error, Severity.Error);
                return;
            }

            _serverRecording = starting;
            if (_module is not null) await _module.InvokeVoidAsync("setRecordingStatus", _serverRecording);
            Snackbar.Add(starting ? "ضبط سروری جلسه شروع شد." : "درخواست توقف ضبط سروری ارسال شد.", Severity.Info);
        }
        catch (JSException ex)
        {
            Snackbar.Add($"ارتباط با سرویس ضبط برقرار نشد: {ex.Message}", Severity.Error);
        }
    }

    private async Task TranscribeAsync()
    {
        if (!_isPresenter || _transcribing) return;
        _transcribing = true;
        try
        {
            var (transcript, error) = await Rooms.TranscribeAsync(MeetingId, CancellationToken.None);
            if (error is not null)
            {
                Snackbar.Add(error, Severity.Error);
                return;
            }

            _transcript = transcript;
            Snackbar.Add("رونویسی محلی جلسه انجام شد.", Severity.Success);
        }
        finally
        {
            _transcribing = false;
        }
    }

    private async Task ToggleLocalRecordingAsync()
    {
        if (_module is null) return;
        try
        {
            if (_localRecording)
            {
                await _module.InvokeVoidAsync("stopLocalRecording");
                return;
            }

            if (!await JS.InvokeAsync<bool>("confirm", "ضبط محلی از زبانه یا صفحه‌ای که انتخاب می‌کنید انجام می‌شود و فایل‌ها فقط روی دستگاه شما ذخیره می‌شوند. در پنجرهٔ مرورگر، زبانهٔ جلسه و در صورت نیاز گزینهٔ اشتراک صدا را انتخاب کنید. ضبط را با اطلاع شرکت‌کنندگان انجام دهید.")) return;
            var result = await _module.InvokeAsync<string>("startLocalRecording", MeetingId);
            switch (result)
            {
                case "started-audio":
                    _localRecording = true;
                    _localRecordingPart = 1;
                    Snackbar.Add("ضبط محلی شروع شد؛ فایل‌ها هر ۳۰ دقیقه روی دستگاه شما دانلود می‌شوند.", Severity.Info);
                    break;
                case "started-no-audio":
                    _localRecording = true;
                    _localRecordingPart = 1;
                    Snackbar.Add("ضبط تصویر شروع شد، اما مرورگر صدای زبانه را ارائه نکرد. برای ضبط صدا، زبانهٔ جلسه و گزینهٔ اشتراک صدا را انتخاب کنید.", Severity.Warning);
                    break;
                case "cancelled":
                    break;
                case "unsupported":
                    Snackbar.Add("این مرورگر ضبط صفحه را پشتیبانی نمی‌کند؛ از نسخهٔ جدید Chrome یا Edge استفاده کنید.", Severity.Error);
                    break;
                default:
                    Snackbar.Add($"شروع ضبط محلی ناموفق بود ({result}). مجوز ضبط صفحه را در مرورگر بررسی کنید.", Severity.Error);
                    break;
            }
        }
        catch (JSException ex)
        {
            Snackbar.Add($"ضبط محلی مرورگر در دسترس نیست: {ex.Message}", Severity.Error);
        }
    }


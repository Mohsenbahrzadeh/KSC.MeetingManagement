        _mic = false;
        Snackbar.Add("میکروفن‌ها توسط برگزارکننده بی‌صدا شدند. برای صحبت، درخواست اجازه بفرستید.", Severity.Warning);
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnPermissionRequest(string identity, string name, string capability) => InvokeAsync(() =>
    {
        if (!_isPresenter || !new[] { "speak", "screen-share", "whiteboard" }.Contains(capability)
            || _permissionRequests.Any(request => request.Identity == identity && request.Capability == capability)) return;
        _permissionRequests = [.. _permissionRequests, new PermissionRequest(identity, name, capability)];
        _showParticipants = true;
        Snackbar.Add($"{name} درخواست دسترسی دارد؛ نوع مجوز را انتخاب کنید.", Severity.Info);
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnSpeakDecision(bool allowed) => InvokeAsync(() =>
    {
        _speakRequested = false;
        _speakApproved = allowed;
        Snackbar.Add(allowed
            ? "درخواست صحبت تأیید شد؛ برای صحبت میکروفن را روشن کنید."
            : "درخواست صحبت توسط برگزارکننده رد شد.", allowed ? Severity.Success : Severity.Warning);
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnWhiteboardDecision(bool allowed) => InvokeAsync(() =>
    {
        _whiteboardRequested = false;
        _whiteboardApproved = allowed;
        Snackbar.Add(allowed ? "اجازهٔ ویرایش وایت‌برد تأیید شد." : "درخواست وایت‌برد رد شد.", allowed ? Severity.Success : Severity.Warning);
        StateHasChanged();
    });


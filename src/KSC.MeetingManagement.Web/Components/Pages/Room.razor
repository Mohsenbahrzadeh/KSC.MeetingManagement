@page "/meetings/{MeetingId:guid}/room"
@using KSC.MeetingManagement.Web.Services
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject RoomApiClient Rooms
@inject SessionState Session

<PageTitle>اتاق جلسه | مدیریت جلسات</PageTitle>

<h1 class="ksc-page-title" tabindex="-1">اتاق جلسه</h1>

@if (_phase == Phase.Lobby || _phase == Phase.Waiting || _phase == Phase.Joining)
{
    <MudPaper Class="ksc-card pa-4 ksc-room-lobby" Elevation="0">
        <video @ref="_preview" class="ksc-preview" autoplay playsinline muted aria-label="پیش‌نمایش تصویر شما"></video>
        @if (_previewProblem is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="my-3" role="alert">@_previewProblem</MudAlert>
        }
        <div class="ksc-room-toggles">
            <MudToggleIconButton @bind-Toggled="_mic" Icon="@Icons.Material.Filled.MicOff" ToggledIcon="@Icons.Material.Filled.Mic"
                                 Color="Color.Default" ToggledColor="Color.Primary" aria-label="میکروفون" Disabled="_phase != Phase.Lobby" />
            <MudToggleIconButton Toggled="_camera" ToggledChanged="OnCameraPreviewChanged" Icon="@Icons.Material.Filled.VideocamOff" ToggledIcon="@Icons.Material.Filled.Videocam"
                                 Color="Color.Default" ToggledColor="Color.Primary" aria-label="دوربین" Disabled="_phase != Phase.Lobby" />
        </div>

        @if (_message is not null)
        {
            <MudAlert Severity="@(_phase == Phase.Waiting ? Severity.Info : Severity.Error)" Class="my-3" role="status">@_message</MudAlert>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" OnClick="JoinAsync"
                   Disabled="_phase != Phase.Lobby" StartIcon="@Icons.Material.Filled.MeetingRoom">ورود به جلسه</MudButton>
    </MudPaper>
}

<div class="ksc-room @(_phase == Phase.InRoom ? string.Empty : "d-none")">
    @if (_phase == Phase.InRoom)
    {
        <div class="ksc-room-bar" role="toolbar" aria-label="کنترل جلسه">
            <MudText Typo="Typo.body2">@_participants نفر در اتاق</MudText>
            @if (_state == "reconnecting")
            {
                <MudChip T="string" Color="Color.Warning" Size="Size.Small">در حال اتصال مجدد…</MudChip>
            }
            <MudSpacer />
            <MudToggleIconButton Toggled="_mic" ToggledChanged="SetMicAsync" Icon="@Icons.Material.Filled.MicOff" ToggledIcon="@Icons.Material.Filled.Mic"
                                 Color="Color.Error" ToggledColor="Color.Primary" aria-label="میکروفون" />
            <MudToggleIconButton Toggled="_camera" ToggledChanged="SetCameraAsync" Icon="@Icons.Material.Filled.VideocamOff" ToggledIcon="@Icons.Material.Filled.Videocam"
                                 Color="Color.Error" ToggledColor="Color.Primary" aria-label="دوربین" />
            <MudToggleIconButton Toggled="_sharing" ToggledChanged="SetShareAsync" Icon="@Icons.Material.Filled.ScreenShare" ToggledIcon="@Icons.Material.Filled.StopScreenShare"
                                 Color="Color.Default" ToggledColor="Color.Primary" aria-label="اشتراک صفحه" />
            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="LeaveAsync" StartIcon="@Icons.Material.Filled.CallEnd">خروج</MudButton>
        </div>
    }
    <div @ref="_tiles" class="ksc-room-grid" aria-live="polite"></div>
</div>

@if (_phase == Phase.Ended)
{
    <MudAlert Severity="Severity.Info" role="status">@(_message ?? "از جلسه خارج شدید.")</MudAlert>
    @if (_canReconnect)
    {
        <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" OnClick="ReconnectAsync" StartIcon="@Icons.Material.Filled.Refresh">اتصال دوباره</MudButton>
    }
    <MudButton Class="mt-3" Variant="Variant.Outlined" OnClick="BackToLobby">بازگشت به ورود</MudButton>
}

@code {
    private enum Phase { Lobby, Joining, Waiting, InRoom, Ended }

    private IJSObjectReference? _module;
    private DotNetObjectReference<Room>? _self;
    private ElementReference _preview;
    private ElementReference _tiles;
    private Phase _phase = Phase.Lobby;
    private string? _message;
    private string? _previewProblem;
    private string _state = "connected";
    private int _participants;
    private bool _mic = true;
    private bool _camera = true;
    private bool _sharing;
    private bool _disposed;
    private bool _restartPreview;
    private bool _canReconnect;

    [Parameter]
    public Guid MeetingId { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            // The self view lives in a new element after coming back to the lobby, so it is opened after that render.
            if (_restartPreview)
            {
                _restartPreview = false;
                await RestartPreviewAsync();
            }

            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./ksc-room.js");
        _self = DotNetObjectReference.Create(this);
        if (!await _module.InvokeAsync<bool>("isSupported"))
        {
            _previewProblem = "این مرورگر از تماس تصویری پشتیبانی نمی‌کند. از نسخهٔ جدید Chrome، Edge، Firefox یا Safari استفاده کنید.";
            StateHasChanged();
            return;
        }

        await RestartPreviewAsync();
    }

    private async Task OnCameraPreviewChanged(bool value)
    {
        _camera = value;
        await RestartPreviewAsync();
    }

    /// <summary>Shows the self view and explains, in plain words, why a device could not be opened.</summary>
    private async Task RestartPreviewAsync()
    {
        if (_module is null)
        {
            return;
        }

        var code = await _module.InvokeAsync<string>("startPreview", _preview, _camera, true);
        _previewProblem = code switch
        {
            "ok" => null,
            "NotAllowedError" or "SecurityError" => "دسترسی به دوربین یا میکروفون مسدود است. در تنظیمات مرورگر اجازه بدهید یا بدون آنها وارد شوید.",
            "NotFoundError" or "OverconstrainedError" => "دوربین یا میکروفونی پیدا نشد. می‌توانید فقط شنونده وارد شوید.",
            "NotReadableError" or "AbortError" => "دوربین یا میکروفون در برنامهٔ دیگری در حال استفاده است.",
            _ => "باز کردن دوربین یا میکروفون ممکن نشد.",
        };
        StateHasChanged();
    }

    private async Task JoinAsync()
    {
        if (_module is null || _self is null)
        {
            return;
        }

        _canReconnect = false;
        _phase = Phase.Joining;
        _message = null;
        JoinResult result;
        do
        {
            result = await Rooms.JoinAsync(MeetingId, Session.User?.DisplayName, CancellationToken.None);
            if (result.Outcome != JoinOutcome.Waiting)
            {
                break;
            }

            // The host has not admitted us yet: ask again every few seconds.
            _phase = Phase.Waiting;
            _message = result.Message;
            StateHasChanged();
            await Task.Delay(TimeSpan.FromSeconds(5));
        }
        while (!_disposed);

        if (_disposed)
        {
            return;
        }

        if (result.Room is not { } room)
        {
            _phase = Phase.Lobby;
            _message = result.Message;
            return;
        }

        _phase = Phase.InRoom;
        StateHasChanged();
        await Task.Yield();
        var ice = room.IceServers?.Select(s => new { urls = s.Urls, username = s.Username, credential = s.Credential }).ToArray();
        var outcome = await _module.InvokeAsync<string>("connect", room.ServerUrl, room.Token, ice, _tiles, _self, _mic, _camera);
        if (outcome != "ok")
        {
            _phase = Phase.Lobby;
            _message = "اتصال به اتاق برقرار نشد. اینترنت خود را بررسی کنید و دوباره تلاش کنید.";
            _restartPreview = true;
            return;
        }

        _canReconnect = false;
    }

    private async Task SetMicAsync(bool on)
    {
        _mic = on;
        if (_module is not null)
        {
            _mic = await _module.InvokeAsync<bool>("setMic", on);
        }
    }

    private async Task SetCameraAsync(bool on)
    {
        _camera = on;
        if (_module is not null)
        {
            _camera = await _module.InvokeAsync<bool>("setCamera", on);
        }
    }

    private async Task SetShareAsync(bool on)
    {
        _sharing = on;
        if (_module is not null)
        {
            _sharing = await _module.InvokeAsync<bool>("setScreenShare", on);
        }
    }

    private async Task LeaveAsync()
    {
        _canReconnect = false;
        _phase = Phase.Ended;
        _message = "از جلسه خارج شدید.";
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("disconnect");
        }

        _sharing = false;
    }

    /// <summary>Requests a fresh, short-lived room token instead of reusing the token from the failed connection.</summary>
    private async Task ReconnectAsync()
    {
        if (!_canReconnect || _phase != Phase.Ended)
        {
            return;
        }

        _canReconnect = false;
        await JoinAsync();
    }

    private void BackToLobby()
    {
        _canReconnect = false;
        _phase = Phase.Lobby;
        _message = null;
        _restartPreview = true;
    }

    [JSInvokable]
    public Task OnRoomState(string state) => InvokeAsync(() =>
    {
        _state = state;
        if (state == "disconnected" && _phase == Phase.InRoom)
        {
            _phase = Phase.Ended;
            _message = "ارتباط شما با جلسه قطع شد.";
            _canReconnect = true;
        }

        StateHasChanged();
    });

    [JSInvokable]
    public Task OnParticipantCount(int count) => InvokeAsync(() =>
    {
        _participants = count;
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disconnect");
                await _module.InvokeVoidAsync("stopPreview");
                await _module.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
            {
                // The browser is already gone; its devices are released with it.
            }
        }

        _self?.Dispose();
    }
}

    public Task OnScreenShare(bool sharing) => InvokeAsync(() =>
    {
        _sharing = sharing;
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnMuteAllNotice() => InvokeAsync(() =>
    {
        _muteAllNotice = true;

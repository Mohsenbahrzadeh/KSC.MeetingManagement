@page "/login"
@using System.ComponentModel.DataAnnotations
@using KSC.MeetingManagement.Web.Services
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>ورود | مدیریت جلسات</PageTitle>

<section class="ksc-login-page" dir="rtl">
    <div class="ksc-login-shell">
        <aside class="ksc-login-visual" aria-label="ابزارهای مدیریت جلسه">
            <div class="ksc-login-visual-top">
                <span class="ksc-login-brand-mark" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Groups" /></span>
                <span>مدیریت جلسات</span>
            </div>

            <div class="ksc-login-message">
                <span class="ksc-login-kicker"><span></span> فضای کاری سازمان</span>
                <h2>از دستور جلسه<br /><span>تا پیگیری تصمیم‌ها.</span></h2>
                <p>برنامه‌ریزی جلسه، ثبت صورت‌جلسه و دنبال‌کردن مصوبات در یک فضای کاری مشترک.</p>
            </div>

            <div class="ksc-login-art" aria-hidden="true">
                <div class="ksc-login-feature"><span><MudIcon Icon="@Icons.Material.Filled.CalendarMonth" /></span><strong>برنامه‌ریزی</strong><small>تقویم و زمان‌بندی جلسه‌ها</small></div>
                <div class="ksc-login-feature"><span><MudIcon Icon="@Icons.Material.Filled.Description" /></span><strong>مستندسازی</strong><small>دستور جلسه و صورت‌جلسه</small></div>
                <div class="ksc-login-feature"><span><MudIcon Icon="@Icons.Material.Filled.TaskAlt" /></span><strong>پیگیری</strong><small>مصوبات و اقدامات مسئولان</small></div>
            </div>

            <div class="ksc-login-visual-foot"><span></span> ورود امن به فضای کاری سازمان</div>
        </aside>

        <div class="ksc-login-form-panel">
            <div class="ksc-login-form-inner">
                <div class="ksc-login-mobile-brand">
                    <span class="ksc-login-mobile-mark" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Groups" /></span>
                    <span>مدیریت جلسات</span>
                </div>
                <span class="ksc-login-welcome">حساب سازمانی</span>
                <h1 tabindex="-1">ورود به حساب کاربری</h1>
                <p class="ksc-login-intro">برای دسترسی به جلسه‌ها و ابزارهای کاری، وارد حساب خود شوید.</p>

                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="ksc-login-error" role="alert">@_error</MudAlert>
                }

                <EditForm Model="_model" OnValidSubmit="SignInAsync" FormName="login" class="ksc-login-form">
                    <DataAnnotationsValidator />
                    <label class="ksc-login-label" for="login-email">نشانی ایمیل</label>
                    <MudTextField @bind-Value="_model.Email" Label="" InputId="login-email" InputType="InputType.Email" Placeholder="you@example.com" Variant="Variant.Outlined"
                                  Immediate="true" AutoFocus="true" Class="ksc-login-field" Margin="Margin.Dense"
                                  Disabled="_busy" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Email"
                                  autocomplete="username" />
                    <label class="ksc-login-label" for="login-password">گذرواژه</label>
                    <MudTextField @bind-Value="_model.Password" Label="" InputId="login-password" InputType="InputType.Password" Placeholder="گذرواژهٔ حساب خود را وارد کنید" Variant="Variant.Outlined"
                                  Class="ksc-login-field" Margin="Margin.Dense" Disabled="_busy"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Lock" autocomplete="current-password" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                               FullWidth="true" Disabled="_busy" Class="ksc-login-submit">
                        @if (_busy)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ms-2" />
                        }
                        ورود به سامانه
                        @if (!_busy)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Class="ksc-login-submit-icon" />
                        }
                    </MudButton>
                </EditForm>

                <div class="ksc-login-security"><MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" /> ارتباط با فضای کاری شما محافظت می‌شود</div>
            </div>
            <div class="ksc-login-copyright">© مدیریت جلسات <span>·</span> ساخته‌شده برای همکاری بهتر</div>
        </div>
    </div>
</section>

@code {
    private readonly LoginModel _model = new();
    private bool _busy;
    private string? _error;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        if (Session.IsSignedIn)
        {
            Navigation.NavigateTo(SafeTarget(ReturnUrl), replace: true);
        }
    }

    private async Task SignInAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _error = await Session.LoginAsync(_model.Email, _model.Password, CancellationToken.None);
            if (_error is null)
            {
                Navigation.NavigateTo(SafeTarget(ReturnUrl), replace: true);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Only local paths are accepted, so a crafted link cannot send a user to another site after signing in.</summary>
    public static string SafeTarget(string? returnUrl) =>
        !string.IsNullOrEmpty(returnUrl) && returnUrl[0] == '/' && (returnUrl.Length == 1 || (returnUrl[1] != '/' && returnUrl[1] != '\\'))
            ? returnUrl
            : "/";

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "ایمیل را وارد کنید.")]
        [EmailAddress(ErrorMessage = "ایمیل معتبر نیست.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "گذرواژه را وارد کنید.")]
        public string Password { get; set; } = string.Empty;
    }
}

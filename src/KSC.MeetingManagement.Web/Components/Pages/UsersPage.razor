@page "/users"
@using KSC.MeetingManagement.Application.Identity
@using KSC.MeetingManagement.Web.Components.Common
@using KSC.MeetingManagement.Web.Components.Users
@using KSC.MeetingManagement.Web.Services
@inject UsersApiClient Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>کاربران | مدیریت جلسات</PageTitle>

<MudText Typo="Typo.h4" Class="ksc-page-title" tabindex="-1">کاربران و نقش‌ها</MudText>

<MudStack Row="true" Class="mb-3">
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => ShowAsync(null)">کاربر جدید</MudButton>
</MudStack>

<StatePanel State="_panel" ErrorText="@_error" OnRetry="LoadAsync" EmptyText="کاربری پیدا نشد.">
    <MudTable Items="_items" Dense="true" Hover="true" Elevation="0">
        <HeaderContent>
            <MudTh>نام</MudTh>
            <MudTh>ایمیل</MudTh>
            <MudTh>نقش‌ها</MudTh>
            <MudTh>وضعیت</MudTh>
            <MudTh><span class="visually-hidden">عملیات</span></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="نام">@context.DisplayName</MudTd>
            <MudTd DataLabel="ایمیل"><bdi>@context.Email</bdi></MudTd>
            <MudTd DataLabel="نقش‌ها">@string.Join("، ", context.Roles.Select(RoleText.Label))</MudTd>
            <MudTd DataLabel="وضعیت">
                <MudChip T="string" Size="Size.Small" Color="@(Active(context) ? Color.Success : Color.Default)">@(Active(context) ? "فعال" : "غیرفعال")</MudChip>
            </MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => ShowAsync(context)" aria-label="@("نقش‌های " + context.DisplayName)">نقش‌ها</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => ToggleActiveAsync(context)" aria-label="@((Active(context) ? "غیرفعال کردن " : "فعال کردن ") + context.DisplayName)">@(Active(context) ? "غیرفعال کردن" : "فعال کردن")</MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
</StatePanel>

@code {
    private static readonly DialogOptions Options = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

    private List<MemberDto> _items = [];
    private PanelState _panel = PanelState.Loading;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private static bool Active(MemberDto m) => m.MembershipActive && m.UserActive;

    private async Task LoadAsync()
    {
        _panel = PanelState.Loading;
        var result = await Api.ListAsync(CancellationToken.None);
        if (!result.Succeeded || result.Value is null)
        {
            _error = result.Message ?? ApiResultReader.GenericFailure;
            _panel = PanelState.Error;
            return;
        }

        _items = result.Value;
        _panel = _items.Count == 0 ? PanelState.Empty : PanelState.Ready;
    }

    private async Task ShowAsync(MemberDto? member)
    {
        var parameters = new DialogParameters<MemberFormDialog> { { d => d.Member, member } };
        var dialog = await Dialogs.ShowAsync<MemberFormDialog>(member is null ? "کاربر جدید" : "نقش‌های کاربر", parameters, Options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task ToggleActiveAsync(MemberDto member)
    {
        var result = await Api.SetActiveAsync(member.UserId, !Active(member), CancellationToken.None);
        if (result.Succeeded)
        {
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Message ?? ApiResultReader.GenericFailure, Severity.Error);
        }
    }
}

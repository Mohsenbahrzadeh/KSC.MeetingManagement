@page "/meetings/{MeetingId:guid}"
@using KSC.MeetingManagement.Application.Meetings
@using KSC.MeetingManagement.Calendar
@using KSC.MeetingManagement.Domain.Meetings
@using KSC.MeetingManagement.Web.Components.Common
@using KSC.MeetingManagement.Web.Components.Meetings
@using KSC.MeetingManagement.Web.Services
@inject MeetingsApiClient Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>@(_meeting?.Title ?? "جزئیات جلسه") | مدیریت جلسات</PageTitle>

<StatePanel State="_panel" ErrorText="@_error" OnRetry="LoadAsync">
    @if (_meeting is { } m)
    {
        <div class="ksc-meeting-console">
            <header class="ksc-meeting-console-header">
                <div class="ksc-meeting-title-block">
                    <MudButton Variant="Variant.Text" Href="/meetings" Size="Size.Small" Class="ksc-meeting-breadcrumb" StartIcon="@Icons.Material.Filled.ArrowForward">جلسه‌ها</MudButton>
                    <div class="ksc-meeting-title-line">
                        <div>
                            <span class="ksc-meeting-number">جلسه@(m.Number is null ? "" : $" · {PersianText.Digits(m.Number)}")</span>
                            <MudText Typo="Typo.h4" Class="ksc-meeting-console-title" id="meeting-title" tabindex="-1">@m.Title</MudText>
                        </div>
                        <MudChip T="string" Size="Size.Small" Class="@($"ksc-meeting-status {CalendarStatusText.CssClass((CalendarItemStatus)(int)m.Status)}")">@CalendarStatusText.Label((CalendarItemStatus)(int)m.Status)</MudChip>
                    </div>
                </div>
                <div class="ksc-meeting-toolbar" aria-label="عملیات جلسه">
                    @if (m.Status == MeetingStatus.Scheduled)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="() => RunAsync(StartText, v => Api.StartAsync(MeetingId, v, CancellationToken.None))" Disabled="_busy">شروع جلسه</MudButton>
                    }
                    @if (HasRoom(m))
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.MeetingRoom" Href="@($"/meetings/{m.Id}/room")">ورود به اتاق</MudButton>
                    }
                    @if (m.Status == MeetingStatus.InProgress)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Stop" OnClick="() => RunAsync(EndText, v => Api.EndAsync(MeetingId, v, CancellationToken.None))" Disabled="_busy">پایان جلسه</MudButton>
                    }
                    @if (m.Status is not (MeetingStatus.Cancelled or MeetingStatus.Completed))
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditAsync" Disabled="_busy">ویرایش</MudButton>
                    }
                    @if (m.Status == MeetingStatus.Scheduled)
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.EventBusy" OnClick="() => RunAsync(PostponeText, v => Api.PostponeAsync(MeetingId, v, CancellationToken.None))" Disabled="_busy">به تعویق انداختن</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="CancelMeetingAsync" Disabled="_busy">لغو جلسه</MudButton>
                    }
                    else if (m.Status is MeetingStatus.Draft or MeetingStatus.Postponed)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="CancelMeetingAsync" Disabled="_busy">لغو جلسه</MudButton>
                    }
                </div>
            </header>

            @if (_actionError is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" role="alert">@_actionError</MudAlert>
            }

            <section class="ksc-meeting-at-a-glance" aria-label="اطلاعات اصلی جلسه">
                <div><MudIcon Icon="@Icons.Material.Outlined.Event" /><span>زمان</span><strong>@TimeText(m)</strong></div>
                <div><MudIcon Icon="@(m.Mode == MeetingMode.InPerson ? Icons.Material.Outlined.Place : Icons.Material.Outlined.Videocam)" /><span>نحوهٔ برگزاری</span><strong>@ModeLabel(m.Mode)</strong></div>
                @if (m.StartedAtUtc is { } startedAt)
                {
                    <div><MudIcon Icon="@Icons.Material.Outlined.PlayCircle" /><span>شروع واقعی</span><strong>@Stamp(startedAt)</strong></div>
                }
                @if (m.EndedAtUtc is { } endedAt)
                {
                    <div><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" /><span>پایان واقعی</span><strong>@Stamp(endedAt)</strong></div>
                }
            </section>

            <div class="ksc-meeting-workspace-layout">
                <nav class="ksc-meeting-section-nav" aria-label="بخش‌های جلسه">
                    <button type="button" class="ksc-meeting-section-tab @TabClass("overview")" aria-pressed="@(_activeSection == "overview")" @onclick='() => SelectSection("overview")'>
                        <MudIcon Icon="@Icons.Material.Outlined.Dashboard" /><span>نمای کلی</span>
                    </button>
                    <button type="button" class="ksc-meeting-section-tab @TabClass("participants")" aria-pressed="@(_activeSection == "participants")" @onclick='() => SelectSection("participants")'>
                        <MudIcon Icon="@Icons.Material.Outlined.PeopleAlt" /><span>شرکت‌کنندگان</span>
                    </button>
                    <button type="button" class="ksc-meeting-section-tab @TabClass("agenda")" aria-pressed="@(_activeSection == "agenda")" @onclick='() => SelectSection("agenda")'>
                        <MudIcon Icon="@Icons.Material.Outlined.FormatListNumbered" /><span>دستور جلسه</span>
                    </button>
                    <button type="button" class="ksc-meeting-section-tab @TabClass("followup")" aria-pressed="@(_activeSection == "followup")" @onclick='() => SelectSection("followup")'>
                        <MudIcon Icon="@Icons.Material.Outlined.FactCheck" /><span>اسناد و پیگیری</span>
                    </button>
                </nav>

                <section class="ksc-meeting-section-content" aria-label="@ActiveSectionLabel">
                    @if (_activeSection == "overview")
                    {
                        <section class="ksc-meeting-overview" aria-labelledby="meeting-overview-title">
                            <div class="ksc-meeting-content-heading">
                                <div><span>فضای جلسه</span><h2 id="meeting-overview-title">نمای کلی</h2></div>
                                <span>@ActionHint(m.Status)</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(m.Description))
                            {
                                <article class="ksc-meeting-description">
                                    <h3>دربارهٔ جلسه</h3>
                                    <div class="ksc-rich-output">@((MarkupString)RichTextContent.ToDisplayHtml(m.Description, Meeting.MaxDescriptionLength))</div>
                                </article>
                            }
                            else
                            {
                                <div class="ksc-meeting-description-empty"><MudIcon Icon="@Icons.Material.Outlined.Notes" /><span>برای این جلسه توضیحی ثبت نشده است.</span></div>
                            }
                            <div class="ksc-meeting-shortcuts" aria-label="دسترسی سریع">
                                <button type="button" @onclick='() => SelectSection("participants")'><MudIcon Icon="@Icons.Material.Outlined.PeopleAlt" /><span><strong>شرکت‌کنندگان</strong><small>اعضا و مهمان‌های دعوت‌شده</small></span><MudIcon Icon="@Icons.Material.Filled.ArrowBack" /></button>
                                <button type="button" @onclick='() => SelectSection("agenda")'><MudIcon Icon="@Icons.Material.Outlined.FormatListNumbered" /><span><strong>دستور جلسه</strong><small>موضوع‌ها و ترتیب گفتگو</small></span><MudIcon Icon="@Icons.Material.Filled.ArrowBack" /></button>
                                <button type="button" @onclick='() => SelectSection("followup")'><MudIcon Icon="@Icons.Material.Outlined.FactCheck" /><span><strong>اسناد و پیگیری</strong><small>صورت‌جلسه، مصوبات و اقدامات</small></span><MudIcon Icon="@Icons.Material.Filled.ArrowBack" /></button>
                            </div>
                        </section>
                    }
                    else if (_activeSection == "participants")
                    {
                        <ParticipantsPanel MeetingId="m.Id" CanEdit="@(m.Status is not (MeetingStatus.Cancelled or MeetingStatus.Completed))" />
                    }
                    else if (_activeSection == "agenda")
                    {
                        <AgendaPanel MeetingId="m.Id" CanEdit="@(m.Status is not (MeetingStatus.Cancelled or MeetingStatus.Completed))" />
                    }
                    else
                    {
                        <section class="ksc-meeting-followup" aria-labelledby="meeting-followup-title">
                            <div class="ksc-meeting-content-heading">
                                <div><span>بایگانی و اقدام</span><h2 id="meeting-followup-title">اسناد و پیگیری</h2></div>
                                <span>همهٔ خروجی‌های مرتبط با این جلسه</span>
                            </div>
                            <div class="ksc-followup-grid">
                                <a href="@($"/meetings/{m.Id}/minutes")"><span class="ksc-followup-icon"><MudIcon Icon="@Icons.Material.Filled.Description" /></span><span><strong>صورت‌جلسه</strong><small>ثبت گفتگوها و جمع‌بندی جلسه</small></span><MudIcon Icon="@Icons.Material.Filled.ArrowBack" /></a>
                                <a href="@($"/meetings/{m.Id}/resolutions")"><span class="ksc-followup-icon"><MudIcon Icon="@Icons.Material.Filled.Gavel" /></span><span><strong>مصوبات</strong><small>تصمیم‌های گرفته‌شده در جلسه</small></span><MudIcon Icon="@Icons.Material.Filled.ArrowBack" /></a>
                                <a href="@($"/meetings/{m.Id}/actions")"><span class="ksc-followup-icon"><MudIcon Icon="@Icons.Material.Filled.TaskAlt" /></span><span><strong>اقدامات پیگیری</strong><small>مسئول، مهلت و وضعیت اجرا</small></span><MudIcon Icon="@Icons.Material.Filled.ArrowBack" /></a>
                                <a href="@($"/meetings/{m.Id}/attachments")"><span class="ksc-followup-icon"><MudIcon Icon="@Icons.Material.Filled.AttachFile" /></span><span><strong>پیوست‌ها</strong><small>فایل‌ها و مستندات جلسه</small></span><MudIcon Icon="@Icons.Material.Filled.ArrowBack" /></a>
                            </div>
                        </section>
                    }
                </section>
            </div>
        </div>
    }
</StatePanel>

@code {
    private const string StartText = "جلسه را اکنون شروع می‌کنید؟";
    private const string PostponeText = "جلسه به تعویق می‌افتد و باید دوباره زمان‌بندی شود. ادامه می‌دهید؟";
    private const string EndText = "جلسه پایان می‌یابد و اتاق بسته می‌شود. ادامه می‌دهید؟";

    private static readonly DialogOptions Options = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

    private readonly CalendarLayout _layout = new(TehranClock.TimeZone);
    private MeetingDto? _meeting;
    private PanelState _panel = PanelState.Loading;
    private string? _error;
    private string? _actionError;
    private bool _busy;
    private string _activeSection = "overview";

    [Parameter] public Guid MeetingId { get; set; }

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _panel = PanelState.Loading;
        var result = await Api.GetAsync(MeetingId, CancellationToken.None);
        if (!result.Succeeded || result.Value is null)
        {
            _error = result.Message ?? ApiResultReader.GenericFailure;
            _panel = PanelState.Error;
            return;
        }

        _meeting = result.Value;
        _activeSection = "overview";
        _panel = PanelState.Ready;
    }

    private async Task RunAsync(string question, Func<long, Task<ApiResult<MeetingDto>>> action)
    {
        if (_meeting is null || await Dialogs.ShowMessageBoxAsync(new MessageBoxOptions { Message = question, YesText = "بله", CancelText = "انصراف" }) != true)
        {
            return;
        }

        _busy = true;
        _actionError = null;
        try
        {
            var result = await action(_meeting.Version);
            if (result.Succeeded && result.Value is { } updated)
            {
                _meeting = updated;
            }
            else
            {
                _actionError = result.Message ?? ApiResultReader.GenericFailure;
                if (result.Error == ApiErrorKind.VersionConflict)
                {
                    await LoadAsync();
                }
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CancelMeetingAsync()
    {
        if (_meeting is null)
        {
            return;
        }

        var parameters = new DialogParameters<CancelMeetingDialog> { { d => d.MeetingId, _meeting.Id }, { d => d.Version, _meeting.Version } };
        var dialog = await Dialogs.ShowAsync<CancelMeetingDialog>("لغو جلسه", parameters, Options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: MeetingDto updated })
        {
            _meeting = updated;
        }
    }

    private async Task EditAsync()
    {
        var parameters = new DialogParameters<MeetingFormDialog> { { d => d.Layout, _layout }, { d => d.MeetingId, MeetingId } };
        var dialog = await Dialogs.ShowAsync<MeetingFormDialog>("ویرایش جلسه", parameters, Options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private static string ModeLabel(MeetingMode mode) => mode switch
    {
        MeetingMode.InPerson => "حضوری",
        MeetingMode.Online => "آنلاین",
        MeetingMode.Hybrid => "ترکیبی",
        _ => "—",
    };

    private static bool HasRoom(MeetingDto m) =>
        m.Mode is MeetingMode.Online or MeetingMode.Hybrid && m.Status is MeetingStatus.Scheduled or MeetingStatus.InProgress;

    private string TabClass(string section) => _activeSection == section ? "active" : string.Empty;

    private string ActiveSectionLabel => _activeSection switch
    {
        "participants" => "شرکت‌کنندگان",
        "agenda" => "دستور جلسه",
        "followup" => "اسناد و پیگیری",
        _ => "نمای کلی",
    };

    private void SelectSection(string section)
    {
        if (section is "overview" or "participants" or "agenda" or "followup")
        {
            _activeSection = section;
        }
    }

    private static string ActionHint(MeetingStatus status) => status switch
    {
        MeetingStatus.Scheduled => "ورود به اتاق، شروع یا ویرایش زمان جلسه",
        MeetingStatus.InProgress => "جلسه در حال برگزاری است",
        MeetingStatus.Completed => "جلسه به پایان رسیده است",
        MeetingStatus.Cancelled => "این جلسه لغو شده است",
        _ => "جزئیات و برنامهٔ جلسه را مدیریت کنید",
    };

    private string Stamp(DateTimeOffset instant) =>
        $"{PersianText.Format(_layout.DayOf(instant))} {PersianText.Time(_layout.TimeOf(instant))}";

    private string TimeText(MeetingDto m) =>
        m.StartUtc is { } start && m.EndUtc is { } end
            ? $"{PersianText.Format(_layout.DayOf(start))} {PersianText.Time(_layout.TimeOf(start))}–{PersianText.Time(_layout.TimeOf(end))}"
            : "زمان‌بندی نشده";
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/KSC.MeetingManagement.Calendar/ksc-calendar.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap nonce="@Nonce" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // Per-request value from WebSecurityHeadersMiddleware; the inline import map is allowed by the content security policy only with it.
    private string? Nonce => HttpContext?.Items[KSC.MeetingManagement.Web.Security.WebSecurityHeadersMiddleware.NonceKey] as string;
}
